{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "functions": {
    "api/offerte.js": {
      "includeFiles": "src/weekzicht.html",
      "maxDuration": 30
    },
    "api/ai-planning.js": {
      "maxDuration": 120
    },
    "api/assistent.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/herinneringen",
      "schedule": "*/5 * * * *"
    }
  ]
}
